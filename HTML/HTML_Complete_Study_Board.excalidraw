      "text": "Q3. What are the main parts of an HTML document?",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Q3. What are the main parts of an HTML document?",
