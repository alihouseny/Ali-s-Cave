      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Answer: It contains metadata such as title, character set, links to CSS, and other document information.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Answer: It contains metadata such as title, character set, links to CSS, and other document information.",
