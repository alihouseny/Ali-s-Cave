      "text": "Q20. What is semantic HTML?",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Q20. What is semantic HTML?",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "html-study-105",
      "type": "text",
      "x": 105,
      "y": 8745,
      "width": 1260,
      "height": 29.0,
      "angle": 0,
