      "text": "Q21. Why is the name attribute important for radio buttons?",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Q21. Why is the name attribute important for radio buttons?",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "html-study-108",
      "type": "text",
      "x": 105,
      "y": 8945,
      "width": 1260,
      "height": 29.0,
      "angle": 0,
