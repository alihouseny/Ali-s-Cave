      "link": null,
      "locked": false,
      "text": "<a href=\"https://example.com\">Visit site</a>\n\ntarget=\"_self\"  → same tab (default)\ntarget=\"_blank\" → new tab\n\nClickable image = put <img> inside <a>.\n<img src=\"profile.jpg\" alt=\"profile photo\" width=\"300\">",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "<a href=\"https://example.com\">Visit site</a>\n\ntarget=\"_self\"  → same tab (default)\ntarget=\"_blank\" → new tab\n\nClickable image = put <img> inside <a>.\n<img src=\"profile.jpg\" alt=\"profile photo\" width=\"300\">",
      "autoResize": false,
      "lineHeight": 1.25
