      "text": "Q4. What is the use of the <head> tag?",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Q4. What is the use of the <head> tag?",
