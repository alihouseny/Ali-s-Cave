      "text": "Q30. Can an HTML tag have duplicate attributes?",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Q30. Can an HTML tag have duplicate attributes?",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "html-study-135",
      "type": "text",
      "x": 105,
      "y": 10745,
      "width": 1260,
      "height": 29.0,
      "angle": 0,
      "strokeColor": "#252525",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 926218,
      "version": 1,
      "versionNonce": 516209,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Answer: No. Avoid duplicate attribute names in the same tag; browsers may ignore later duplicates and behavior is not reliable.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Answer: No. Avoid duplicate attribute names in the same tag; browsers may ignore later duplicates and behavior is not reliable.",
      "autoResize": false,
      "lineHeight": 1.25
    }
