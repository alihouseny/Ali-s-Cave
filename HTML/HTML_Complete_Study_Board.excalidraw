      "text": "Q18. What is a void/empty element?",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Q18. What is a void/empty element?",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "html-study-99",
      "type": "text",
      "x": 105,
      "y": 8345,
      "width": 1260,
      "height": 29.0,
      "angle": 0,
      "strokeColor": "#252525",
      "backgroundColor": "transparent",
