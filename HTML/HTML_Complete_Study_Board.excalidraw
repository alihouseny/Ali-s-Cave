      "version": 1,
      "versionNonce": 982503,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Answer: It declares the document type and tells the browser to use HTML standards mode.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Answer: It declares the document type and tells the browser to use HTML standards mode.",
      "autoResize": false,
      "lineHeight": 1.25
    },
