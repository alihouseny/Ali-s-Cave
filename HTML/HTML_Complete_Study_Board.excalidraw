      "text": "Q29. Can an image be a link?",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Q29. Can an image be a link?",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "html-study-132",
      "type": "text",
      "x": 105,
      "y": 10545,
