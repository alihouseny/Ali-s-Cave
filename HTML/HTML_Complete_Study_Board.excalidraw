      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Attributes provide extra information about elements.\nExamples: id, class, src, href, alt, width, style, required, placeholder.\n\nRULE: do NOT repeat the same attribute in one tag.\n<img src=\"cat.jpg\" src=\"dog.jpg\" alt=\"animal\">\nThe browser uses the first src; the second is ignored.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Attributes provide extra information about elements.\nExamples: id, class, src, href, alt, width, style, required, placeholder.\n\nRULE: do NOT repeat the same attribute in one tag.\n<img src=\"cat.jpg\" src=\"dog.jpg\" alt=\"animal\">\nThe browser uses the first src; the second is ignored.",
      "autoResize": false,
      "lineHeight": 1.25
    },
