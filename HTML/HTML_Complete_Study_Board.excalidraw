      "updated": 1,
      "link": null,
      "locked": false,
      "text": "HTML skeleton → <!DOCTYPE> + html + head + body\nTags → opening/closing vs empty\nText → h1–h6, p, br, hr, formatting\nLinks → a + href + target\nImages → img + src + alt\nLayout → div vs span\nMedia → video, audio, iframe\nLists → ol / ul / dl\nTables → table / tr / th / td / colspan / rowspan\nForms → form / input types / placeholder / required / radio name\nAttributes → never duplicate the same attribute name in one tag",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "HTML skeleton → <!DOCTYPE> + html + head + body\nTags → opening/closing vs empty\nText → h1–h6, p, br, hr, formatting\nLinks → a + href + target\nImages → img + src + alt\nLayout → div vs span\nMedia → video, audio, iframe\nLists → ol / ul / dl\nTables → table / tr / th / td / colspan / rowspan\nForms → form / input types / placeholder / required / radio name\nAttributes → never duplicate the same attribute name in one tag",
      "autoResize": false,
      "lineHeight": 1.25
    },
