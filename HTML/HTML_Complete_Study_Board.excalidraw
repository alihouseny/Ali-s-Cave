      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Tag = instruction written inside < >.\nMost tags have opening + closing tags:\n<p>This is a paragraph.</p>\n\nEmpty tags have no closing counterpart:\n<br>   <hr>   <img src=\"photo.jpg\" alt=\"a photo\">",
      "fontSize": 23,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tag = instruction written inside < >.\nMost tags have opening + closing tags:\n<p>This is a paragraph.</p>\n\nEmpty tags have no closing counterpart:\n<br>   <hr>   <img src=\"photo.jpg\" alt=\"a photo\">",
      "autoResize": false,
      "lineHeight": 1.25
    },
