      "version": 1,
      "versionNonce": 425388,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "<div> = block-level container → starts on a new line / used for sections & layout.\n<span> = inline container → stays in the text flow / targets a small part of text.\n\nRule of thumb:\nDIV = a BOX 📦\nSPAN = a HIGHLIGHTER 🖍️",
      "fontSize": 23,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "<div> = block-level container → starts on a new line / used for sections & layout.\n<span> = inline container → stays in the text flow / targets a small part of text.\n\nRule of thumb:\nDIV = a BOX 📦\nSPAN = a HIGHLIGHTER 🖍️",
      "autoResize": false,
      "lineHeight": 1.25
    },
