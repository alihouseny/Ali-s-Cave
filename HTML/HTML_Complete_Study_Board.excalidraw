      "versionNonce": 293696,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Answer: It uses meaningful elements such as <header>, <nav>, <main>, <section>, <article>, and <footer> to describe content structure.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Answer: It uses meaningful elements such as <header>, <nav>, <main>, <section>, <article>, and <footer> to describe content structure.",
      "autoResize": false,
      "lineHeight": 1.25
    },
