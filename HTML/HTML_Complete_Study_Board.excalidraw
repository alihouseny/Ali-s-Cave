      "text": "Q19. Difference between id and class?",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Q19. Difference between id and class?",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "html-study-102",
      "type": "text",
      "x": 105,
      "y": 8545,
      "width": 1260,
      "height": 29.0,
      "angle": 0,
      "strokeColor": "#252525",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
