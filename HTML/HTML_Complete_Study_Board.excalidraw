      "text": "Q22. Why use type=\"tel\" for phone numbers?",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Q22. Why use type=\"tel\" for phone numbers?",
