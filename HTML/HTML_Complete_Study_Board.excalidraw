      "roundness": null,
      "seed": 750652,
      "version": 1,
      "versionNonce": 581156,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "ORDERED LIST <ol>\n<ol type=\"A\" start=\"3\"><li>Step C</li><li>Step D</li></ol>\nType: 1 / A / a / I\n\nUNORDERED LIST <ul>\n<ul type=\"square\"><li>HTML</li><li>CSS</li></ul>\nType: disc / circle / square\n\nDEFINITION LIST <dl> + <dt>term</dt> + <dd>description</dd>\n\nTABLE\n<table> → <thead> → <tbody> → <tfoot>\n<tr> row • <th> header cell • <td> data cell\ncolspan = merge horizontally • rowspan = merge vertically",
      "fontSize": 21,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ORDERED LIST <ol>\n<ol type=\"A\" start=\"3\"><li>Step C</li><li>Step D</li></ol>\nType: 1 / A / a / I\n\nUNORDERED LIST <ul>\n<ul type=\"square\"><li>HTML</li><li>CSS</li></ul>\nType: disc / circle / square\n\nDEFINITION LIST <dl> + <dt>term</dt> + <dd>description</dd>\n\nTABLE\n<table> → <thead> → <tbody> → <tfoot>\n<tr> row • <th> header cell • <td> data cell\ncolspan = merge horizontally • rowspan = merge vertically",
      "autoResize": false,
      "lineHeight": 1.25
    },
