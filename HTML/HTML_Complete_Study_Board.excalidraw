      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Answer: It is intended for telephone input, preserves characters such as + and leading zeros, and commonly shows a phone keypad on mobile.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Answer: It is intended for telephone input, preserves characters such as + and leading zeros, and commonly shows a phone keypad on mobile.",
      "autoResize": false,
      "lineHeight": 1.25
    },
