      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "VIDEO\n<video src=\"movie.mp4\" width=\"600\" controls muted autoplay loop>\n  Your browser does not support video.\n</video>\n\ncontrols = player UI • muted = no sound • autoplay = starts automatically • loop = repeats\n\nAUDIO\n<audio src=\"song.mp3\" controls autoplay loop muted></audio>\n\nIFRAME\n<iframe src=\"https://www.youtube.com/embed/...\" width=\"560\" height=\"315\"></iframe>\nThink: iframe = a window showing external content.\n\nTEXTAREA\n<textarea rows=\"5\" cols=\"40\" placeholder=\"Write your message here...\"></textarea>",
      "fontSize": 21,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "VIDEO\n<video src=\"movie.mp4\" width=\"600\" controls muted autoplay loop>\n  Your browser does not support video.\n</video>\n\ncontrols = player UI • muted = no sound • autoplay = starts automatically • loop = repeats\n\nAUDIO\n<audio src=\"song.mp3\" controls autoplay loop muted></audio>\n\nIFRAME\n<iframe src=\"https://www.youtube.com/embed/...\" width=\"560\" height=\"315\"></iframe>\nThink: iframe = a window showing external content.\n\nTEXTAREA\n<textarea rows=\"5\" cols=\"40\" placeholder=\"Write your message here...\"></textarea>",
      "autoResize": false,
      "lineHeight": 1.25
    },
