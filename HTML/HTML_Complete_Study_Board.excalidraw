      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Answer: HTML (HyperText Markup Language) is the standard markup language used to create and structure web pages.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Answer: HTML (HyperText Markup Language) is the standard markup language used to create and structure web pages.",
      "autoResize": false,
      "lineHeight": 1.25
    },
