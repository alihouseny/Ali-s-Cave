      "versionNonce": 611182,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Answer: Radio buttons with the same name belong to one group, so selecting one deselects the others.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Answer: Radio buttons with the same name belong to one group, so selecting one deselects the others.",
      "autoResize": false,
      "lineHeight": 1.25
