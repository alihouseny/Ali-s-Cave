      "version": 1,
      "versionNonce": 683689,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Answer: id identifies a specific element and should be unique in a document; class can be reused on multiple elements.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Answer: id identifies a specific element and should be unique in a document; class can be reused on multiple elements.",
      "autoResize": false,
      "lineHeight": 1.25
    },
