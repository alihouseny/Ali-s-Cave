      "text": "Q2. What is the purpose of <!DOCTYPE html>?",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Q2. What is the purpose of <!DOCTYPE html>?",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "html-study-51",
      "type": "text",
      "x": 105,
      "y": 5145,
      "width": 1260,
      "height": 29.0,
      "angle": 0,
      "strokeColor": "#252525",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
