    {
      "id": "html-study-40",
      "type": "text",
      "x": 120,
      "y": 3727,
      "width": 1180,
      "height": 580.0,
      "angle": 0,
      "strokeColor": "#252525",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 862678,
      "version": 1,
      "versionNonce": 738133,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "<form action=\"https://example.com/submit\" method=\"POST\">\n  <input type=\"text\" placeholder=\"Enter your name\" required>\n  <input type=\"email\" placeholder=\"example@mail.com\">\n  <input type=\"password\">\n  <input type=\"tel\" placeholder=\"+20 100 000 0000\">\n  <input type=\"number\" min=\"1\" max=\"100\">\n  <input type=\"checkbox\" name=\"hobby\" value=\"reading\"> Reading\n  <input type=\"radio\" name=\"gender\" value=\"male\"> Male\n  <input type=\"radio\" name=\"gender\" value=\"female\"> Female\n  <input type=\"submit\" value=\"Send Form\">\n</form>\n\nPHONE TIP: use type=\"tel\", not number.\ntel keeps +, spaces and leading zeros and opens a phone keypad.\n\nplaceholder = hint inside input\nrequired = field must be filled\n\nRADIO RULE: same name + different value = one group.\nDifferent names = independent radio buttons.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "<form action=\"https://example.com/submit\" method=\"POST\">\n  <input type=\"text\" placeholder=\"Enter your name\" required>\n  <input type=\"email\" placeholder=\"example@mail.com\">\n  <input type=\"password\">\n  <input type=\"tel\" placeholder=\"+20 100 000 0000\">\n  <input type=\"number\" min=\"1\" max=\"100\">\n  <input type=\"checkbox\" name=\"hobby\" value=\"reading\"> Reading\n  <input type=\"radio\" name=\"gender\" value=\"male\"> Male\n  <input type=\"radio\" name=\"gender\" value=\"female\"> Female\n  <input type=\"submit\" value=\"Send Form\">\n</form>\n\nPHONE TIP: use type=\"tel\", not number.\ntel keeps +, spaces and leading zeros and opens a phone keypad.\n\nplaceholder = hint inside input\nrequired = field must be filled\n\nRADIO RULE: same name + different value = one group.\nDifferent names = independent radio buttons.",
      "autoResize": false,
      "lineHeight": 1.25
    },
