      "versionNonce": 317758,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Answer: An element that does not wrap content and has no closing tag, such as <br>, <hr>, and <img>.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Answer: An element that does not wrap content and has no closing tag, such as <br>, <hr>, and <img>.",
      "autoResize": false,
      "lineHeight": 1.25
    },
